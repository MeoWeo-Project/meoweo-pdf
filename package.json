{
  "name": "meoweo-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side PDF and image tools: organize, convert, compress and protect. No upload, no server.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "meoweo-shared": "github:MeoWeo-Project/meoweo-shared#v0.1.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
